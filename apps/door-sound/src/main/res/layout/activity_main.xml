<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed, non-scrolling layout: all eight event cards are on screen at once.
  The previous version was a vertical ScrollView in which only about 2.5 of the
  cards were visible and "Lock" was cut off below the fold.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aurora_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/content_padding_h"
        android:paddingRight="@dimen/content_padding_h"
        android:paddingTop="@dimen/space_5"
        android:paddingBottom="@dimen/space_5">

        <!-- Header: identity, live status, master switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="@dimen/text_h3"
                    android:textColor="@color/fg_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textSize="@dimen/text_body_s"
                    android:textColor="@color/fg_secondary" />
            </LinearLayout>

            <!-- Status capsule, at the top where it is actually visible -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/space_6"
                android:layout_marginRight="@dimen/space_6"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/glass_status_capsule"
                android:elevation="@dimen/elevation_1"
                android:outlineProvider="background"
                android:paddingLeft="@dimen/pill_padding_h"
                android:paddingRight="@dimen/pill_padding_h"
                android:paddingTop="@dimen/pill_padding_v"
                android:paddingBottom="@dimen/pill_padding_v">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="@dimen/icon_status"
                    android:layout_height="@dimen/icon_status"
                    android:layout_marginRight="@dimen/space_2"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/text_service_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_stopped"
                    android:textSize="@dimen/text_status"
                    android:textColor="@color/fg_primary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_last_event"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/space_3"
                    android:text="@string/no_events_yet"
                    android:textSize="@dimen/text_body_s"
                    android:textColor="@color/fg_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/space_3"
                android:text="@string/enabled"
                android:textSize="@dimen/text_body_l"
                android:textColor="@color/fg_secondary" />

            <Switch
                android:id="@+id/switch_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:track="@drawable/glass_switch_track_off"
                android:thumb="@drawable/glass_switch_thumb"
                android:switchMinWidth="@dimen/switch_width"
                android:textOff=""
                android:textOn="" />
        </LinearLayout>

        <!-- Segmented tabs, with the hint alongside rather than on its own line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/glass_segmented_bg"
            android:padding="@dimen/segmented_padding">

            <TextView
                android:id="@+id/tab_inside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_inside"
                android:textSize="@dimen/text_body_l"
                android:textColor="@color/fg_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="@dimen/space_6"
                android:paddingRight="@dimen/space_6"
                android:paddingTop="@dimen/segmented_btn_padding_v"
                android:paddingBottom="@dimen/segmented_btn_padding_v" />

            <TextView
                android:id="@+id/tab_outside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_outside"
                android:textSize="@dimen/text_body_l"
                android:textColor="@color/fg_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="@dimen/space_6"
                android:paddingRight="@dimen/space_6"
                android:paddingTop="@dimen/segmented_btn_padding_v"
                android:paddingBottom="@dimen/segmented_btn_padding_v" />
        </LinearLayout>

        <TextView
            android:id="@+id/tab_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_4"
            android:text="@string/hint_inside"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/fg_tertiary"
            android:maxLines="2" />
        </LinearLayout>

        <!-- Card grids; rows are built in code from SoundEvent.values() -->
        <LinearLayout
            android:id="@+id/content_inside"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/content_outside"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
