<?xml version="1.0" encoding="utf-8"?>
<!-- One interior-speaker event. Sized by the parent row; do not set width here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/glass_panel_1"
    android:elevation="@dimen/elevation_2"
    android:outlineProvider="background"
    android:padding="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_body"
            android:textColor="@color/fg_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <Switch
            android:id="@+id/card_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:track="@drawable/glass_switch_track_off"
            android:thumb="@drawable/glass_switch_thumb"
            android:switchMinWidth="@dimen/switch_width"
            android:textOff=""
            android:textOn="" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_file_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/no_file_selected"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/fg_secondary"
        android:maxLines="1"
        android:ellipsize="middle" />

    <TextView
        android:id="@+id/card_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/warning"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/card_btn_select"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/select_file"
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/fg_on_brand"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glass_btn_primary"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/card_btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_2"
            android:minHeight="48dp"
            android:text="@string/clear"
            android:textSize="@dimen/text_body_s"
            android:textColor="@color/fg_primary"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glass_btn_ghost"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volume"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/fg_secondary" />

        <SeekBar
            android:id="@+id/card_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/space_1"
            android:layout_marginRight="@dimen/space_1" />

        <TextView
            android:id="@+id/card_volume_label"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/fg_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="end" />
    </LinearLayout>
</LinearLayout>
